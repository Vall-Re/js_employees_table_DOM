    // POSITION VALIDATION
    var positionLetters = position.match(/[A-Za-z]/g) || [];
    if (positionLetters.length < 2) {
        showNotification("Error", "The position must contain at least 2 letters", "error");
        return;
    }
    // AGE VALIDATION
