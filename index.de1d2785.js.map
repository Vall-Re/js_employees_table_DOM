var sortColumn = null;
var sortDirection = true; // true = ASC, false = DESC
var activeInput = null;
// ===== СОРТУВАННЯ =====
function sortTable(index, direction) {
    var rows = Array.from(tbody.querySelectorAll("tr"));
    rows.sort(function(a, b) {
        var cellA = a.children[index].textContent.trim().replace(/[^\d.]/g, "");
        var cellB = b.children[index].textContent.trim().replace(/[^\d.]/g, "");
        var isNumber = index === 3 || index === 4;
