    var newRow = document.createElement("tr");
    newRow.innerHTML = "\n    <td>".concat(nameEmp, "</td>\n    <td>").concat(position, "</td>\n    <td>").concat(office, "</td>\n    <td>").concat(age, "</td>\n    <td>").concat(formatSalary(salary), "</td>\n  ");
    tbody.append(newRow);
    form.reset();
    showNotification("Success", "Employee added to table", "success");
